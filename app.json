{
  "expo": {
    "name": "Псалтир",
    "slug": "psaltir-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/novaikonica.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splashikonica.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C0C0C"
    },
    "assetBundlePatterns": [
      "assets/**/*",
      "src/**/*"
    ],
                "ios": {
              "supportsTablet": true,
              "bundleIdentifier": "com.psaltir.app",
              "buildNumber": "31",
              "infoPlist": {
        "NSCameraUsageDescription": "Ова апликација користи камеру за скенирање QR кодова.",
        "NSMicrophoneUsageDescription": "Ова апликација користи микрофон за снимање молитви.",
        "NSAppleMusicUsageDescription": "Ова апликација користи музику за репродукцију псалама.",
        "UIBackgroundModes": [
          "audio"
        ],
        "AVAudioSessionCategoryPlayback": true,
        "AVAudioSessionCategoryOptions": [
          "AVAudioSessionCategoryOptionMixWithOthers",
          "AVAudioSessionCategoryOptionDuckOthers"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/novaikonica.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.psaltir.app",
      "versionCode": 31,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "scheme": "psaltir",
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Ова апликација користи микрофон за снимање молитви."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ова апликација користи камеру за скенирање QR кодова."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "jsEngine": "hermes",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c418547-9801-450f-b612-1bf318870494"
      }
    }
  }
}
